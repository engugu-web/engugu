{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "docs",
  "headers": [
    { "source": "/carousel/manifest.json", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ],
  "rewrites": [
    { "source": "/carousel/:path*", "destination": "https://engugu-web.github.io/orangeGlobalMedia-images/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
